#!/usr/bin/env bash
# The `ive` command that get.sh links into ~/.local/bin.
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in
    /*) self="$target" ;;
    *) self="$(dirname -- "$self")/$target" ;;
  esac
done
IVE_DIR="$(cd -- "$(dirname -- "$self")/.." && pwd -P)"
STATE_DIR="$IVE_DIR/.ive-team-state"
PID_FILE="$STATE_DIR/ive.pid"
URL_FILE="$STATE_DIR/ive.url"
ARGS_FILE="$STATE_DIR/ive.args"
LOG_FILE="$STATE_DIR/ive.log"
LOCK_FILE="$STATE_DIR/backend.lock"
SERVER="$IVE_DIR/backend/server.py"
# Left by `IVE_INSTALL=source bash install.sh`: this folder runs from source.
SOURCE_MARKER="$STATE_DIR/source-build"
# The folder as it can be pasted into a shell, for the hints below.
IVE_HERE="$(printf %q "$IVE_DIR")"
LOG_LIMIT=10485760

usage() {
  if uses_mac_app; then
    cat <<USAGE
Usage: ive [command]

On this Mac, IVE is the Mac app.

  ive                 Open the Mac app, installing it first if it is missing
  ive update          Update the Mac app to the latest release
  ive status          Show whether an IVE built from this folder is running
  ive stop            Stop an IVE built from this folder
  ive uninstall       Remove this folder (the Mac app stays)
  ive help            Show this help

To run this folder from source instead, in a browser on localhost:
  IVE_INSTALL=source bash $IVE_HERE/install.sh
USAGE
    return 0
  fi
  cat <<USAGE
Usage: ive [command] [options]

  ive                 Start IVE in the background and open it in your browser
  ive --headless      Start IVE in the background without opening a browser
  ive stop            Stop IVE
  ive status          Show whether IVE is running and where
  ive logs            Follow IVE's log (Ctrl+C to leave, IVE keeps running)
  ive run             Run IVE in this terminal (for systemd, launchd, containers)
  ive update          Download the latest version, rebuild and restart a running IVE
  ive uninstall       Stop IVE, remove its hooks, the app folder and this command
                      (--yes skips the question)
  ive help            Show this help

Options for starting: --port N, --host ADDRESS and the other start.sh options.

IVE lives in $IVE_DIR
USAGE
  if [ -f "$SOURCE_MARKER" ]; then
    echo ""
    echo "This folder is a source build on request. To switch to the Mac app: IVE_INSTALL=app bash $IVE_HERE/install.sh"
  fi
}

require_installed() {
  if [ ! -f "$STATE_DIR/instance.json" ]; then
    if uses_mac_app; then
      echo "This folder has no source build. On this Mac, IVE is the Mac app. Open it with: $IVE_HERE/bin/ive" >&2
      echo "To build this folder from source: IVE_INSTALL=source bash $IVE_HERE/install.sh" >&2
    elif [ "${IVE_INSTALL:-}" = source ]; then
      echo "IVE is not installed yet. Run: IVE_INSTALL=source bash $IVE_HERE/install.sh" >&2
    else
      echo "IVE is not installed yet. Run: bash $IVE_HERE/install.sh" >&2
    fi
    exit 1
  fi
}

# True if PID $1 is a server of this installation (start.sh runs it as
# "<python> -s <IVE_DIR>/backend/server.py ...").
is_ive_server() {
  [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null || return 1
  ps -p "$1" -o command= 2>/dev/null \
    | awk -v s=" -s $SERVER" 'index($0, s) && tolower($1) ~ /python[0-9.]*$/ { found = 1 } END { exit !found }'
}

lock_pid() {
  { head -n 1 "$LOCK_FILE" 2>/dev/null || true; } | tr -cd '0-9'
}

# Every server of this installation: the one `ive` started, the one holding
# the data folder lock and any started with `ive run` or start.sh.
server_pids() {
  {
    cat "$PID_FILE" 2>/dev/null || true
    echo
    lock_pid
    echo
    ps -A -o pid= -o command= 2>/dev/null | grep -F -- " -s $SERVER" | awk '{print $1}' || true
  } | tr -cd '0-9\n' | sort -u | while read -r pid; do
    if is_ive_server "$pid"; then echo "$pid"; fi
  done
}

first_server_pid() {
  local pids
  pids="$(server_pids)"
  echo "${pids%%$'\n'*}"
}

saved_url() {
  cat "$URL_FILE" 2>/dev/null || echo "http://127.0.0.1:5111/"
}

# Reads the start options into HEADLESS, PORT, HOST, SHOW_LOG_HINT and BASE_URL.
parse_start_args() {
  HEADLESS="" PORT=5111 HOST="" SHOW_LOG_HINT=""
  local arg previous=""
  for arg in "$@"; do
    case "$previous" in
      --port) PORT="$arg" ;;
      --host) HOST="$arg" ;;
    esac
    case "$arg" in
      --headless) HEADLESS=1 ;;
      --port=*) PORT="${arg#--port=}" ;;
      --host=*) HOST="${arg#--host=}" ;;
      --tunnel|--multiplayer|--token|--token=*|--public-url|--public-url=*|--external-proxy) SHOW_LOG_HINT=1 ;;
    esac
    previous="$arg"
  done
  local probe_host
  case "$HOST" in
    ""|0.0.0.0|127.0.0.1|localhost) probe_host=127.0.0.1 ;;
    ::|::1|"[::1]") probe_host="[::1]" ;;
    *:*) probe_host="[$HOST]" ;;
    *) probe_host="$HOST" ;;
  esac
  BASE_URL="http://$probe_host:$PORT/"
}

# Runs Python from the installation (or any 3.11+) with a short snippet.
run_python() {
  local python="$IVE_DIR/.venv/bin/python"
  if [ ! -x "$python" ]; then
    source "$IVE_DIR/tools/python.sh"
    python="$(ive_python)" || return 1
  fi
  "$python" -I -c "$@"
}

# True once IVE's /ready answers. /ready needs no login, and proxies are
# bypassed because the server is local.
probe_ready() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsS --noproxy '*' --max-time 2 -o /dev/null "${1}ready" 2>/dev/null
  else
    run_python 'import sys, urllib.request as u; u.build_opener(u.ProxyHandler({})).open(sys.argv[1], timeout=2)' "${1}ready" >/dev/null 2>&1
  fi
}

# True if anything accepts connections on the port.
port_in_use() {
  run_python 'import socket, sys; socket.create_connection((sys.argv[1].strip("[]"), int(sys.argv[2])), 2).close()' \
    "$(echo "$1" | sed -E 's#^http://([^/]*):[0-9]+/$#\1#')" "$2" >/dev/null 2>&1
}

open_browser() {
  if [ "$(uname -s)" = Darwin ]; then
    open "$1" 2>/dev/null || echo "Open $1 in your browser."
  elif command -v xdg-open >/dev/null 2>&1; then
    # Some xdg-open setups wait for the browser; never let that block ive.
    set -m
    nohup xdg-open "$1" >/dev/null 2>&1 </dev/null &
    set +m
  else
    echo "Open $1 in your browser."
  fi
}

# Keeps the log bounded. The server appends, so truncating in place is safe.
trim_log() {
  if [ -f "$LOG_FILE" ] && [ "$(wc -c <"$LOG_FILE" | tr -d ' ')" -gt "$LOG_LIMIT" ]; then
    cp "$LOG_FILE" "$LOG_FILE.1" && : >"$LOG_FILE"
  fi
}

save_args() {
  : >"$ARGS_FILE"
  chmod 600 "$ARGS_FILE"
  local arg
  for arg in "$@"; do printf '%s\n' "$arg" >>"$ARGS_FILE"; done
}

start() {
  require_installed
  parse_start_args "$@"

  local pid
  pid="$(first_server_pid)"
  if [ -n "$pid" ]; then
    echo "IVE is already running at $(saved_url) (process $pid)."
    [ -n "$HEADLESS" ] || open_browser "$(saved_url)"
    return 0
  fi
  if port_in_use "$BASE_URL" "$PORT"; then
    echo "Port $PORT is already in use by another program. Stop it, or pick another port: ive --port 5121" >&2
    exit 1
  fi

  trim_log
  echo "$BASE_URL" >"$URL_FILE"
  save_args "$@"
  printf '\n--- %s: ive start\n' "$(date '+%Y-%m-%d %H:%M:%S')" >>"$LOG_FILE"

  # Own process group, so Ctrl+C in this terminal never reaches the server.
  # The server keeps this PID: start.sh and the launcher exec into it.
  set -m
  nohup bash "$IVE_DIR/start.sh" --headless "$@" >>"$LOG_FILE" 2>&1 </dev/null &
  pid=$!
  set +m
  echo "$pid" >"$PID_FILE"

  printf 'Starting IVE'
  local i
  for i in $(seq 1 120); do
    if ! kill -0 "$pid" 2>/dev/null; then
      echo ""
      echo "IVE could not start. Last lines of $LOG_FILE:" >&2
      tail -n 20 "$LOG_FILE" >&2
      rm -f "$PID_FILE"
      exit 1
    fi
    # Only our own server counts: it holds the data folder lock.
    if [ "$(lock_pid)" = "$pid" ] && probe_ready "$BASE_URL"; then
      echo ""
      echo "IVE is running at $BASE_URL"
      echo "You can close this terminal. Stop IVE with: ive stop"
      [ -z "$SHOW_LOG_HINT" ] || echo "The access token and share link are in the log: ive logs"
      [ -n "$HEADLESS" ] || open_browser "$BASE_URL"
      return 0
    fi
    printf '.'
    sleep 0.5
  done
  echo ""
  echo "IVE has not answered within a minute. Check: ive status, ive logs" >&2
}

run_foreground() {
  require_installed
  parse_start_args "$@"
  local pid
  pid="$(first_server_pid)"
  if [ -n "$pid" ]; then
    echo "IVE is already running at $(saved_url) (process $pid). Stop it first: ive stop" >&2
    exit 1
  fi
  echo "$BASE_URL" >"$URL_FILE"
  save_args "$@"
  # exec keeps this PID for the server, so stop/status/uninstall see it.
  echo "$$" >"$PID_FILE"
  exec bash "$IVE_DIR/start.sh" "$@"
}

alive_servers() {
  local pid
  for pid in "$@"; do
    if is_ive_server "$pid"; then echo "$pid"; fi
  done
}

stop() {
  local pids pid i
  pids="$(server_pids)"
  if [ -z "$pids" ]; then
    echo "IVE is not running."
    rm -f "$PID_FILE"
    return 0
  fi
  printf 'Stopping IVE'
  for pid in $pids; do kill -TERM "$pid" 2>/dev/null || true; done
  for i in $(seq 1 120); do
    pids="$(alive_servers $pids)"
    [ -n "$pids" ] || break
    printf '.'
    sleep 0.5
  done
  echo ""
  if [ -n "$pids" ]; then
    echo "IVE did not stop within a minute; forcing it." >&2
    for pid in $pids; do
      if is_ive_server "$pid"; then kill -KILL "$pid" 2>/dev/null || true; fi
    done
    sleep 1
  fi
  rm -f "$PID_FILE"
  echo "IVE is stopped."
}

status() {
  trim_log
  local pid
  pid="$(first_server_pid)"
  if [ -n "$pid" ]; then
    echo "IVE is running at $(saved_url) (process $pid)."
  else
    echo "IVE is not running. Start it with: ive"
    return 1
  fi
}

update() {
  if ! git -C "$IVE_DIR" fetch --quiet; then
    echo "Update failed: could not download the new version. IVE was not changed." >&2
    exit 1
  fi
  if ! git -C "$IVE_DIR" merge-base --is-ancestor HEAD '@{u}' 2>/dev/null; then
    echo "Update failed: $IVE_DIR has commits that are not in the official version. IVE was not changed." >&2
    exit 1
  fi

  local was_running="" saved=() arg
  if [ -n "$(server_pids)" ]; then was_running=1; fi
  if [ -f "$ARGS_FILE" ]; then
    while IFS= read -r arg; do saved+=("$arg"); done <"$ARGS_FILE"
  fi
  [ -z "$was_running" ] || stop

  if ! git -C "$IVE_DIR" merge --ff-only --quiet '@{u}' || ! IVE_INSTALL=source bash "$IVE_DIR/install.sh"; then
    [ -z "$was_running" ] || echo "Update failed. IVE is stopped; start it again with: ive" >&2
    exit 1
  fi
  if [ -n "$was_running" ]; then start --headless ${saved[@]+"${saved[@]}"}; fi
}

uninstall() {
  # Refuse anything that does not look like an IVE checkout.
  if [ ! -f "$IVE_DIR/ive-team.json" ] || [ ! -f "$IVE_DIR/bin/ive" ]; then
    echo "ive uninstall: $IVE_DIR does not look like an IVE folder, nothing removed." >&2
    exit 1
  fi
  # A folder that only installed the app has no state folder, so no hooks,
  # data or server, and removing it needs nothing else, not even Python.
  local app_only="" app=""
  if uses_mac_app && [ ! -d "$STATE_DIR" ]; then app_only=1; fi
  if [ "$(uname -s)" = Darwin ]; then app="$(installed_mac_app)"; fi
  local answer=""
  if [ "${1:-}" = "--yes" ]; then
    answer=y
  elif [ -n "$app_only" ]; then
    printf 'Remove the folder %s? The Mac app stays. [y/N] ' "$IVE_DIR"
    read -r answer </dev/tty || true
  else
    printf 'Remove IVE from %s, including its local data? [y/N] ' "$IVE_DIR"
    read -r answer </dev/tty || true
  fi
  case "$answer" in
    y|Y|yes|YES) ;;
    *) echo "Nothing removed."; exit 0 ;;
  esac

  if [ -z "$app_only" ]; then
    stop
    if [ -n "$(server_pids)" ]; then
      echo "IVE is still running, so nothing was removed. Quit it and try again." >&2
      exit 1
    fi
    source "$IVE_DIR/tools/python.sh"
    local python
    python="$(ive_python)" || exit 1
    # Without the hooks gone, deleting the folder would break every agent call.
    if ! "$python" -I "$IVE_DIR/tools/ive_team.py" --root "$IVE_DIR" remove-hooks; then
      echo "Nothing was removed." >&2
      exit 1
    fi
  fi
  local link
  for link in "$(command -v ive || true)" "${IVE_BIN_DIR:-$HOME/.local/bin}/ive"; do
    if [ -L "$link" ] && [ "$link" -ef "$IVE_DIR/bin/ive" ]; then
      rm -f -- "$link"
    fi
  done
  rm -r -f -- "$IVE_DIR"
  echo "$IVE_DIR is removed. Your projects were not touched, and your coding CLIs stay installed."
  if [ -n "$app" ]; then
    echo "The Mac app stays in $app."
    # A source server replaces the app's Safety Gate when it starts.
    [ -n "$app_only" ] || echo "If it is open, quit and reopen it, which sets its hooks again."
    echo "To remove it too, quit it, run"
    echo "  \"$app/Contents/Resources/backend/ive-backend\" --remove-hooks"
    echo "and drag it to the Trash."
  fi
}

# True on a Mac that gets the app (see get.sh), unless this folder was built
# from source on request. IVE_INSTALL decides over the marker.
uses_mac_app() {
  case "${IVE_INSTALL:-}" in
    source) return 1 ;;
    app) ;;
    *) [ ! -f "$SOURCE_MARKER" ] || return 1 ;;
  esac
  [ "$(uname -s)" = Darwin ] && bash "$IVE_DIR/get.sh" --mac-app-check >/dev/null 2>&1
}

# Prints the path of the installed IVE app, or nothing.
installed_mac_app() {
  # The order get.sh installs in, so that update and start find the same copy.
  local dirs=(/Applications "$HOME/Applications") dir
  [ -w /Applications ] || dirs=("$HOME/Applications" /Applications)
  [ -z "${IVE_APP_DIR:-}" ] || dirs=("$IVE_APP_DIR")
  for dir in "${dirs[@]}"; do
    if [ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$dir/IVE.app/Contents/Info.plist" 2>/dev/null)" = com.ive.desktop ]; then
      printf '%s\n' "$dir/IVE.app"
      return 0
    fi
  done
}

# Says what is left of a source build in this folder when the app takes over.
note_source_build() {
  if [ -n "$(server_pids)" ]; then
    echo "An IVE built from this folder is still running in the background. Stop it with: $IVE_HERE/bin/ive stop"
  fi
  if [ -f "$STATE_DIR/data.db" ]; then
    echo "This folder's source build keeps its projects and history in $STATE_DIR, and the Mac app has separate data. To keep using the source build: IVE_INSTALL=source bash $IVE_HERE/install.sh"
  fi
}

# Opens the app. Without one yet, get.sh installs it and opens it.
open_mac_app() {
  if [ $# -gt 0 ]; then
    echo "The Mac app has no command or option '$1'. To run this folder from source: IVE_INSTALL=source bash $IVE_HERE/install.sh" >&2
    exit 1
  fi
  note_source_build
  local app
  app="$(installed_mac_app)"
  if [ -z "$app" ]; then
    exec bash "$IVE_DIR/get.sh"
  fi
  echo "Opening $app"
  open "$app"
}

start_ive() {
  if uses_mac_app; then
    open_mac_app "$@"
  else
    start "$@"
  fi
}

case "${IVE_INSTALL:-}" in
  ""|app|source) ;;
  *) echo "ive: IVE_INSTALL must be 'app' or 'source', not '$IVE_INSTALL'." >&2; exit 1 ;;
esac

case "${1:-}" in
  help|-h|--help)
    usage
    ;;
  stop)
    if uses_mac_app && [ -z "$(server_pids)" ]; then
      echo "On this Mac, IVE is the Mac app, and nothing from this folder is running. Quit the app with Cmd+Q."
    else
      stop
    fi
    ;;
  status)
    if uses_mac_app && [ -z "$(server_pids)" ]; then
      echo "On this Mac, IVE is the Mac app, and nothing from this folder is running. Open the app with: $IVE_HERE/bin/ive"
      exit 1
    else
      status
    fi
    ;;
  logs)
    require_installed
    trim_log
    touch "$LOG_FILE"
    exec tail -n 100 -F "$LOG_FILE"
    ;;
  run)
    shift
    run_foreground "$@"
    ;;
  update)
    if uses_mac_app; then
      note_source_build
      exec bash "$IVE_DIR/get.sh"
    fi
    update
    ;;
  uninstall)
    uninstall "${2:-}"
    ;;
  start)
    shift
    start_ive "$@"
    ;;
  *)
    start_ive "$@"
    ;;
esac
